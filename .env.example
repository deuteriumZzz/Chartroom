# Демо-значения для `docker compose up`. Для реального запуска: cp .env.example .env и заменить секреты.
DATABASE_URL=postgresql+asyncpg://chartroom:chartroom@db:5432/chartroom
JWT_SECRET=demo-only-change-me-in-dotenv-0123456789abcdef
JWT_TTL_MINUTES=60
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
# Ключ Gemini API нужен worker-у индексации. Задайте его в .env (не в этом файле):
# GEMINI_API_KEY=...
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
